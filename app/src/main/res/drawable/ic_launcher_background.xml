<?xml version="1.0" encoding="utf-8"?>
<!--
  Signal lime, lit from the top left and deepening toward the bottom right, so the tile reads
  as one bright object on any wallpaper. The whole 108dp canvas: masks take the outer third.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android" xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0 H108 V108 H0 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear" android:startX="0" android:startY="0" android:endX="108" android:endY="108">
                <item android:offset="0" android:color="#FFE2FF7A" />
                <item android:offset="0.55" android:color="#FFC8FF4D" />
                <item android:offset="1" android:color="#FF8CCB1E" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
