    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_offline_title">Nothing leaves the phone</string>
    <string name="about_offline_body">Stave has no internet permission, so it cannot send a recording anywhere. The models run on the device. You can check the permission on the Play listing.</string>
    <string name="about_free_title">Every tool is free</string>
    <string name="about_free_body">No account, no cap, no watermark, no ad, no subscription. There is no server to pay for, so there is nothing to gate.</string>
    <string name="about_open_title">The code is public</string>
    <string name="about_open_body">Stave is GPL-3.0. Every filter and every rule is in the repository and is executed by a test on every change.</string>
    <string name="about_family">From the makers of Squish, Still and Sheaf.</string>
    <string name="about_licences">Third-party notices</string>

